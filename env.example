# Отримати на https://my.telegram.org -> API development tools
API_ID=1234567
API_HASH=your_api_hash

# Результат gen_session.py (рядок сесії)
SESSION_STRING=1BVts...

# Канал-джерело (без @)
SOURCE=Tsaplienko

# Ваш канал: @username або числовий id (-100xxxxxxxxxx)
TARGET=@your_channel

# copy = як новий пост + підпис | forward = з позначкою "Forwarded from"
MODE=copy

# Підпис внизу кожного посту
FOOTER_TEXT=🇺🇦 Review News / Підписатися
FOOTER_URL=https://t.me/reviewnews

# Як часто (секунди) додатково звіряти джерело. Основна реакція миттєва.
POLL_INTERVAL=10
